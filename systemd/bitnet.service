[Unit]
Description=BitNet Inference Server (OpenAI-compatible API)
Documentation=https://github.com/microsoft/BitNet
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/bitnet
ExecStart=llama-server -m models/bitnet_b1_58-3B.gguf --host 127.0.0.1 --port 8000
# Uncomment if llama-server was installed from a prebuilt archive:
# Environment=LD_LIBRARY_PATH=%h/.local/lib
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
